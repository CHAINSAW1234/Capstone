  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "  \"\"\uB97C \uC120\uD0DD\uD558\uC168\uC2B5\uB2C8\uB2E4.\r\n  \uC5F0\uC2B5
    \uBAA8\uB4DC\uC5D0\uC11C\uB294 \uAC01 \uC0C1\uD669\uBCC4 \uD589\uB3D9\uC744 \uB2E8\uACC4\uC801\uC73C\uB85C
    \uC548\uB0B4\uD558\uBA70, AI \uAE30\uBC18 \uAC00\uC0C1 \uC5D0\uC774\uC804\uD2B8\uB97C
    \uD1B5\uD574 \uB300\uD53C \uACFC\uC815\uC744 \uD559\uC2B5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. 
    \r\n  \uD3C9\uAC00 \uBAA8\uB4DC\uC5D0\uC11C\uB294 \uB2E8\uACC4\uBCC4 \uC548\uB0B4
    \uBC0F \uAC00\uC0C1 \uC5D0\uC774\uC804\uD2B8 \uC5C6\uC774 \uC0AC\uC6A9\uC790\uC758
    \uD310\uB2E8\uACFC \uD589\uB3D9\uC5D0 \uB530\uB77C \uD3C9\uAC00\uAC00 \uC774\uB8E8\uC5B4\uC9D1\uB2C8\uB2E4.\r\n\r 
    \uC5F0\uC2B5 \uBAA8\uB4DC \uB610\uB294 \uD3C9\uAC00 \uBAA8\uB4DC\uB97C \uC120\uD0DD\uD574
    \uC8FC\uC2ED\uC2DC\uC624.\r\n\r\n"
  m_isRightToLeft: 0
