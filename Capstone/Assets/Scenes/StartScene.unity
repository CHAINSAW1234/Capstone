  m_text: "  \uC774 \uD504\uB85C\uC81D\uD2B8\uB294 \uC878\uC5C5 \uACFC\uC81C\uB85C
    \uC81C\uC791\uB41C \uD654\uC7AC \uB300\uD53C \n\uC2DC\uBBAC\uB808\uC774\uD130\uC785\uB2C8\uB2E4.\r\n 
    \uD654\uC7AC \uBC1C\uC0DD \uC2DC\uC758 \uB300\uD53C \uD589\uB3D9\uACFC \uC18C\uD654\uAE30
    \uC0AC\uC6A9 \uBC29\uBC95\uC744 \uCCB4\uD5D8\uD558\uACE0 \uD559\uC2B5\uD560 \uC218
    \uC788\uB3C4\uB85D \uAD6C\uC131\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n  \uC544\uB798\uC5D0\uC11C
    \uC6D0\uD558\uB294 \uD559\uC2B5 \uD56D\uBAA9\uC744\uC120\uD0DD\uD574\uC8FC\uC138\uC694.\r\n"
